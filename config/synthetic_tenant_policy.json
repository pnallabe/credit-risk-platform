{
  "policy_id": "SYN_POL_001",
  "policy_type": "underwriting_policy",
  "version": "1.0",
  "effective_date": "2024-01-01",
  "tenant_id": "synthetic_tenant",
  "underwriting_rules": {
    "min_credit_score": 600,
    "max_dti": 0.50,
    "min_annual_income": 20000,
    "max_ltv": 1.00,
    "acceptable_loan_purposes": ["personal", "auto", "education", "other"],
    "max_concentration_single_applicant": 0.10,
    "max_concentration_single_purpose": 0.50
  },
  "pricing_rules": {
    "base_rate_methodology": "WACC + credit_spread + operational_cost",
    "WACC": 0.08,
    "operational_cost_bps": 200,
    "credit_spread_by_grade": {
      "A": 250,
      "B": 450,
      "C": 700,
      "D": 1000,
      "E": 1500
    }
  },
  "risk_appetite": {
    "max_portfolio_default_rate": 0.12,
    "target_roa": 0.10,
    "max_single_loan_loss_given_default": 0.75
  }
}
