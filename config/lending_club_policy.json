{
  "policy_id": "LC_POL_001",
  "policy_type": "underwriting_policy",
  "version": "1.0",
  "effective_date": "2024-01-01",
  "tenant_id": "lending_club",
  "underwriting_rules": {
    "min_credit_score": 620,
    "max_dti": 0.45,
    "min_annual_income": 25000,
    "max_ltv": 0.85,
    "acceptable_loan_purposes": ["debt_consolidation", "home_improvement", "business", "major_purchase", "medical", "moving", "small_business", "vacation", "wedding"],
    "max_concentration_single_applicant": 0.05,
    "max_concentration_single_purpose": 0.30
  },
  "pricing_rules": {
    "base_rate_methodology": "WACC + credit_spread + operational_cost",
    "WACC": 0.07,
    "operational_cost_bps": 150,
    "credit_spread_by_grade": {
      "A": 200,
      "B": 350,
      "C": 550,
      "D": 800,
      "E": 1200
    }
  },
  "risk_appetite": {
    "max_portfolio_default_rate": 0.08,
    "target_roa": 0.08,
    "max_single_loan_loss_given_default": 0.50
  }
}
