# Python virtual environments
.venv/
venv/
env/

# Large data files - do not copy into Docker images
data/
data/raw/
data/processed/
data/interim/

# ML artifacts - mount as volumes instead
mlruns/
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt

# Node.js
node_modules/
ui/*/node_modules/
ui/*/.next/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.eggs/
.eggs/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover
.hypothesis/

# Development tools
.git/
.gitignore
.github/

# IDE files
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Documentation
docs/
*.md
README*

# Audit / compliance logs (not needed in containers)
# NOTE: audit/ is required by decision-api, do NOT exclude it

# Docker files themselves
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
cloudbuild.yaml
deploy-*.sh
Makefile

# Test files
tests/
pytest.ini

# Jupyter
*.ipynb
.ipynb_checkpoints/

# Logs
*.log
logs/

# Temp files
tmp/
temp/
