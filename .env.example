# =============================================================================
# HelixDecision — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=credit_risk
POSTGRES_USER=credit_user
POSTGRES_PASSWORD=changeme_in_production

# Full async connection URL for SQLAlchemy
DATABASE_URL=postgresql+asyncpg://credit_user:changeme_in_production@localhost:5432/credit_risk  # pragma: allowlist secret  # pragma: allowlist secret

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Change this to a long random string in production!
JWT_SECRET=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=risk-platform

# Comma-separated list of valid API keys (leave empty to disable API key auth)
VALID_API_KEYS=

# ---------------------------------------------------------------------------
# MLflow
# ---------------------------------------------------------------------------
# Use local SQLite for development, remote URI for production
MLFLOW_TRACKING_URI=sqlite:///./mlflow/mlruns.db

# ---------------------------------------------------------------------------
# Model Paths
# ---------------------------------------------------------------------------
FRAUD_MODEL_PATH=models/fraud_detection/fraud_model_v1.pkl
RISK_MODEL_PATH=models/credit_risk/risk_model_v1.pkl

# ---------------------------------------------------------------------------
# Decision API
# ---------------------------------------------------------------------------
DECISION_API_URL=http://localhost:8081

# ---------------------------------------------------------------------------
# Open Banking / Cash-Flow Enrichment
# ---------------------------------------------------------------------------
# Plaid credentials (required for live Plaid flows)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Open Bank Project credentials (required for live OBP flows)
OBP_BASE_URL=
OBP_BANK_ID=
OBP_ACCESS_TOKEN=
OBP_CONSUMER_KEY=
OBP_CONSUMER_SECRET=

# Provider selection for ingestion-api/src/plaid_connector.py
# Valid values: plaid | finicity | openbankproject | mock
BUREAU_PROVIDER=plaid

# ---------------------------------------------------------------------------
# SendGrid (used by ai-agent scheduler for email reports)
# ---------------------------------------------------------------------------
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@helixdecision.com

# ---------------------------------------------------------------------------
# Slack (used by drift monitor alerts and scheduler)
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=
SLACK_MONITORING_CHANNEL=#model-monitoring

# ---------------------------------------------------------------------------
# Google Cloud (for Cloud Run deployment)
# ---------------------------------------------------------------------------
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCP_SA_KEY=

# ---------------------------------------------------------------------------
# GCS Data Pipeline (10M synthetic dataset)
# ---------------------------------------------------------------------------
# GCS bucket created by scripts/setup_gcp_data_infra.sh
GCS_BUCKET=
# Path prefix inside the bucket (default: data)
GCS_DATA_PREFIX=data
# Path to service account JSON key for data pipeline scripts
GOOGLE_APPLICATION_CREDENTIALS=.gcp-sa-key-dev.json

# ---------------------------------------------------------------------------
# Cloud SQL — synchronous (psycopg2) URL for bulk loaders
# ---------------------------------------------------------------------------
# Use Cloud SQL Auth Proxy on localhost:5433 for secure local access:
#   cloud-sql-proxy PROJECT:REGION:INSTANCE --port=5433 &
DATABASE_URL_SYNC=postgresql://credit_user:changeme@127.0.0.1:5433/credit_risk  # pragma: allowlist secret
# Cloud SQL instance connection name (PROJECT:REGION:INSTANCE)
CLOUD_SQL_INSTANCE=

# ---------------------------------------------------------------------------
# OpenAI / AI Agent (Phase 13)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
AGENT_RATE_LIMIT=20/minute
AGENT_API_URL=http://localhost:8082
DRIFT_PSI_THRESHOLD=0.25

# ---------------------------------------------------------------------------
# NextAuth.js (Applicant Portal — port 3000)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=dev-nextauth-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional — set to enable Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# NextAuth.js (Analytics Dashboard — port 3001)
# ---------------------------------------------------------------------------
ANALYTICS_NEXTAUTH_URL=http://localhost:3001
# Same NEXTAUTH_SECRET is shared across both Next.js apps

# Test user credentials for dev (analytics dashboard)
# These are seeded automatically; change before production
UNDERWRITER_TEST_PASSWORD=underwriter123
RISK_ANALYST_TEST_PASSWORD=analyst123
COMPLIANCE_TEST_PASSWORD=compliance123
DATA_SCIENTIST_TEST_PASSWORD=science123
EXECUTIVE_TEST_PASSWORD=executive123

# ---------------------------------------------------------------------------
# Production — Cloud Run backend URLs (set after running deploy-gcp.sh)
# ---------------------------------------------------------------------------
INGESTION_API_URL=https://crp-ingestion-api-prod-<hash>.a.run.app
DECISION_API_URL_PROD=https://crp-decision-api-prod-<hash>.a.run.app
AGENT_API_URL_PROD=https://crp-ai-agent-prod-<hash>.a.run.app

# Production — Vercel frontend URLs
APPLICANT_PORTAL_URL=https://apply.your-domain.com
ANALYTICS_DASHBOARD_URL=https://analytics.your-domain.com

# ---------------------------------------------------------------------------
# Freddie Mac CRT Data Intelligence
# Register at: https://www.freddiemac.com/research/datasets/crt-data-intelligence
# ---------------------------------------------------------------------------
FREDDIE_MAC_USERNAME=your_email@example.com
FREDDIE_MAC_PASSWORD=your_freddie_mac_password
# Optional: pre-obtained Bearer token (bypasses ROPC/SSO entirely).
# Obtain from Chrome DevTools → Network → any XHR to claritydownload.fmapps.freddiemac.com
# → Headers → Authorization (strip the "Bearer " prefix).
FREDDIE_MAC_TOKEN=

# GCS destination prefix for CRT SFLLD data (default: crt/sflld)
GCS_CRT_PREFIX=crt/sflld

# ---------------------------------------------------------------------------
# Other
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development
