# =============================================================================
# Credit Risk Platform — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=credit_risk
POSTGRES_USER=credit_user
POSTGRES_PASSWORD=changeme_in_production

# Full async connection URL for SQLAlchemy
DATABASE_URL=postgresql+asyncpg://credit_user:changeme_in_production@localhost:5432/credit_risk  # pragma: allowlist secret  # pragma: allowlist secret

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Change this to a long random string in production!
JWT_SECRET=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=risk-platform

# Comma-separated list of valid API keys (leave empty to disable API key auth)
VALID_API_KEYS=

# ---------------------------------------------------------------------------
# MLflow
# ---------------------------------------------------------------------------
# Use local SQLite for development, remote URI for production
MLFLOW_TRACKING_URI=sqlite:///./mlflow/mlruns.db

# ---------------------------------------------------------------------------
# Model Paths
# ---------------------------------------------------------------------------
FRAUD_MODEL_PATH=models/fraud_detection/fraud_model_v1.pkl
RISK_MODEL_PATH=models/credit_risk/risk_model_v1.pkl

# ---------------------------------------------------------------------------
# Decision API
# ---------------------------------------------------------------------------
DECISION_API_URL=http://localhost:8081

# ---------------------------------------------------------------------------
# SendGrid (used by ai-agent scheduler for email reports)
# ---------------------------------------------------------------------------
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@credit-risk-platform.com

# ---------------------------------------------------------------------------
# Slack (used by drift monitor alerts and scheduler)
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=
SLACK_MONITORING_CHANNEL=#model-monitoring

# ---------------------------------------------------------------------------
# Google Cloud (for Cloud Run deployment)
# ---------------------------------------------------------------------------
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCP_SA_KEY=

# ---------------------------------------------------------------------------
# OpenAI / AI Agent (Phase 13)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
AGENT_RATE_LIMIT=20/minute
AGENT_API_URL=http://localhost:8082
DRIFT_PSI_THRESHOLD=0.25

# ---------------------------------------------------------------------------
# NextAuth.js (Applicant Portal — port 3000)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=dev-nextauth-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional — set to enable Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# NextAuth.js (Analytics Dashboard — port 3001)
# ---------------------------------------------------------------------------
ANALYTICS_NEXTAUTH_URL=http://localhost:3001
# Same NEXTAUTH_SECRET is shared across both Next.js apps

# Test user credentials for dev (analytics dashboard)
# These are seeded automatically; change before production
UNDERWRITER_TEST_PASSWORD=underwriter123
RISK_ANALYST_TEST_PASSWORD=analyst123
COMPLIANCE_TEST_PASSWORD=compliance123
DATA_SCIENTIST_TEST_PASSWORD=science123
EXECUTIVE_TEST_PASSWORD=executive123

# ---------------------------------------------------------------------------
# Production — Cloud Run backend URLs (set after running deploy-gcp.sh)
# ---------------------------------------------------------------------------
INGESTION_API_URL=https://crp-ingestion-api-prod-<hash>.a.run.app
DECISION_API_URL_PROD=https://crp-decision-api-prod-<hash>.a.run.app
AGENT_API_URL_PROD=https://crp-ai-agent-prod-<hash>.a.run.app

# Production — Vercel frontend URLs
APPLICANT_PORTAL_URL=https://apply.your-domain.com
ANALYTICS_DASHBOARD_URL=https://analytics.your-domain.com

# ---------------------------------------------------------------------------
# Other
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development
